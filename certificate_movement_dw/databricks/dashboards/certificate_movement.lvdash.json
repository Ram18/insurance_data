{
  "datasets": [
    {
      "name": "ds_movement",
      "displayName": "Certificate Movement (metric view)",
      "queryLines": [
        "SELECT\n",
        "  `Movement`,\n",
        "  `Movement Group`,\n",
        "  `End Quarter-Year`,\n",
        "  `End Product Series`,\n",
        "  `End State`,\n",
        "  `End Reporting Entity`,\n",
        "  MEASURE(`Start Count`)      AS start_count,\n",
        "  MEASURE(`End Count`)        AS end_count,\n",
        "  MEASURE(`New Count`)        AS new_count,\n",
        "  MEASURE(`Revived Count`)    AS revived_count,\n",
        "  MEASURE(`Death Count`)      AS death_count,\n",
        "  MEASURE(`Surrendered Count`) AS surrendered_count,\n",
        "  MEASURE(`Lapsed Count`)     AS lapsed_count,\n",
        "  MEASURE(`Matured Count`)    AS matured_count,\n",
        "  MEASURE(`Start DB`)         AS start_db,\n",
        "  MEASURE(`End DB`)           AS end_db,\n",
        "  MEASURE(`Net Increase DB`)  AS net_increase_db,\n",
        "  MEASURE(`Start AnnPayt`)    AS start_annpayt,\n",
        "  MEASURE(`End AnnPayt`)      AS end_annpayt,\n",
        "  MEASURE(`Start FV`)         AS start_fv,\n",
        "  MEASURE(`End FV`)           AS end_fv\n",
        "FROM adw_prod10.star.certificate_movement_metrics\n",
        "GROUP BY 1, 2, 3, 4, 5, 6"
      ]
    }
  ],
  "pages": [
    {
      "name": "movement_summary",
      "displayName": "Movement Summary",
      "layout": [
        {
          "widget": {
            "name": "flt_quarter",
            "queries": [
              {
                "name": "flt_q",
                "query": {
                  "datasetName": "ds_movement",
                  "fields": [
                    { "name": "End Quarter-Year", "expression": "`End Quarter-Year`" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "encodings": {
                "fields": [
                  { "fieldName": "End Quarter-Year", "displayName": "Quarter", "queryName": "flt_q" }
                ]
              }
            }
          },
          "position": { "x": 0, "y": 0, "width": 2, "height": 1 }
        },
        {
          "widget": {
            "name": "kpi_start_count",
            "queries": [ { "name": "q", "query": { "datasetName": "ds_movement",
              "fields": [ { "name": "v", "expression": "SUM(`start_count`)" } ], "disaggregated": false } } ],
            "spec": { "version": 2, "widgetType": "counter",
              "encodings": { "value": { "fieldName": "v", "displayName": "Start Count", "format": { "type": "number-plain", "decimalPlaces": { "type": "max", "places": 0 } } } } }
          },
          "position": { "x": 2, "y": 0, "width": 1, "height": 2 }
        },
        {
          "widget": {
            "name": "kpi_end_count",
            "queries": [ { "name": "q", "query": { "datasetName": "ds_movement",
              "fields": [ { "name": "v", "expression": "SUM(`end_count`)" } ], "disaggregated": false } } ],
            "spec": { "version": 2, "widgetType": "counter",
              "encodings": { "value": { "fieldName": "v", "displayName": "End Count", "format": { "type": "number-plain", "decimalPlaces": { "type": "max", "places": 0 } } } } }
          },
          "position": { "x": 3, "y": 0, "width": 1, "height": 2 }
        },
        {
          "widget": {
            "name": "kpi_new_count",
            "queries": [ { "name": "q", "query": { "datasetName": "ds_movement",
              "fields": [ { "name": "v", "expression": "SUM(`new_count`)" } ], "disaggregated": false } } ],
            "spec": { "version": 2, "widgetType": "counter",
              "encodings": { "value": { "fieldName": "v", "displayName": "New Count", "format": { "type": "number-plain", "decimalPlaces": { "type": "max", "places": 0 } } } } }
          },
          "position": { "x": 4, "y": 0, "width": 1, "height": 2 }
        },
        {
          "widget": {
            "name": "kpi_end_db",
            "queries": [ { "name": "q", "query": { "datasetName": "ds_movement",
              "fields": [ { "name": "v", "expression": "SUM(`end_db`)" } ], "disaggregated": false } } ],
            "spec": { "version": 2, "widgetType": "counter",
              "encodings": { "value": { "fieldName": "v", "displayName": "End Death Benefit", "format": { "type": "number-currency", "decimalPlaces": { "type": "max", "places": 0 }, "currencyCode": "USD" } } } }
          },
          "position": { "x": 5, "y": 0, "width": 1, "height": 2 }
        },
        {
          "widget": {
            "name": "bar_count_by_movement",
            "queries": [ { "name": "q", "query": { "datasetName": "ds_movement",
              "fields": [
                { "name": "Movement", "expression": "`Movement`" },
                { "name": "end_count", "expression": "SUM(`end_count`)" }
              ], "disaggregated": false } } ],
            "spec": { "version": 3, "widgetType": "bar", "frame": { "title": "End Count by Movement", "showTitle": true },
              "encodings": {
                "x": { "fieldName": "Movement", "scale": { "type": "categorical" }, "displayName": "Movement" },
                "y": { "fieldName": "end_count", "scale": { "type": "quantitative" }, "displayName": "End Count" }
              } }
          },
          "position": { "x": 0, "y": 2, "width": 3, "height": 5 }
        },
        {
          "widget": {
            "name": "bar_netdb_by_series",
            "queries": [ { "name": "q", "query": { "datasetName": "ds_movement",
              "fields": [
                { "name": "End Product Series", "expression": "`End Product Series`" },
                { "name": "net_increase_db", "expression": "SUM(`net_increase_db`)" }
              ], "disaggregated": false } } ],
            "spec": { "version": 3, "widgetType": "bar", "frame": { "title": "Net Increase DB by Product Series", "showTitle": true },
              "encodings": {
                "x": { "fieldName": "End Product Series", "scale": { "type": "categorical" }, "displayName": "Product Series" },
                "y": { "fieldName": "net_increase_db", "scale": { "type": "quantitative" }, "displayName": "Net Increase DB" }
              } }
          },
          "position": { "x": 3, "y": 2, "width": 3, "height": 5 }
        },
        {
          "widget": {
            "name": "line_db_trend",
            "queries": [ { "name": "q", "query": { "datasetName": "ds_movement",
              "fields": [
                { "name": "End Quarter-Year", "expression": "`End Quarter-Year`" },
                { "name": "start_db", "expression": "SUM(`start_db`)" },
                { "name": "end_db", "expression": "SUM(`end_db`)" }
              ], "disaggregated": false } } ],
            "spec": { "version": 3, "widgetType": "line", "frame": { "title": "Death Benefit: Start vs End by Quarter", "showTitle": true },
              "encodings": {
                "x": { "fieldName": "End Quarter-Year", "scale": { "type": "categorical" }, "displayName": "Quarter" },
                "y": { "fieldName": "start_db", "scale": { "type": "quantitative" }, "displayName": "Death Benefit" },
                "extra": [ { "fieldName": "end_db", "displayName": "End DB" } ]
              } }
          },
          "position": { "x": 0, "y": 7, "width": 3, "height": 5 }
        },
        {
          "widget": {
            "name": "tbl_by_movement_group",
            "queries": [ { "name": "q", "query": { "datasetName": "ds_movement",
              "fields": [
                { "name": "Movement Group", "expression": "`Movement Group`" },
                { "name": "start_count", "expression": "SUM(`start_count`)" },
                { "name": "end_count", "expression": "SUM(`end_count`)" },
                { "name": "start_db", "expression": "SUM(`start_db`)" },
                { "name": "end_db", "expression": "SUM(`end_db`)" },
                { "name": "end_fv", "expression": "SUM(`end_fv`)" }
              ], "disaggregated": false } } ],
            "spec": { "version": 1, "widgetType": "table", "frame": { "title": "By Movement Group", "showTitle": true },
              "encodings": { "columns": [
                { "fieldName": "Movement Group", "displayName": "Movement Group" },
                { "fieldName": "start_count", "displayName": "Start Count" },
                { "fieldName": "end_count", "displayName": "End Count" },
                { "fieldName": "start_db", "displayName": "Start DB" },
                { "fieldName": "end_db", "displayName": "End DB" },
                { "fieldName": "end_fv", "displayName": "End FV" }
              ] } }
          },
          "position": { "x": 3, "y": 7, "width": 3, "height": 5 }
        }
      ]
    }
  ]
}
