{"cells":[{"cell_type":"code","source":["import csv\n","import random\n","import pandas as pd\n","from faker import Faker\n","from datetime import datetime, timedelta\n","import os\n","\n","# Initialize Faker to generate realistic fake data\n","fake = Faker()\n","\n","# --- Configuration ---\n","NUM_REGIONS = 5\n","NUM_AGENTS = 50\n","NUM_CUSTOMERS = 2000\n","NUM_VEHICLES = 2200 # Slightly more vehicles than customers\n","NUM_POLICIES = 2500 # Some customers might have >1 policy over time\n","NUM_CLAIMS_PER_POLICY_RANGE = (0, 4) # Range for number of claims per policy\n","NUM_PAYMENTS_PER_CLAIM_RANGE = (1, 3) # Range for number of payments per approved/paid claim\n","START_DATE = datetime(2022, 1, 1)\n","END_DATE = datetime(2024, 12, 31)\n","OUTPUT_DIR = \"insurance_data\"\n","\n","# Ensure output directory exists\n","if not os.path.exists(OUTPUT_DIR):\n","    os.makedirs(OUTPUT_DIR)\n","\n","# --- Helper Functions ---\n","def random_date(start, end):\n","    \"\"\"Generate a random datetime between start and end.\"\"\"\n","    return start + timedelta(\n","        seconds=random.randint(0, int((end - start).total_seconds())),\n","    )\n","\n","def generate_vin():\n","    \"\"\"Generate a somewhat realistic fake VIN.\"\"\"\n","    return fake.bothify(text='??#######??######').upper()\n","\n","# --- Data Generation ---\n","\n","# 1. Regions\n","print(\"Generating Regions...\")\n","regions_data = []\n","region_names = [\"Northeast\", \"Southeast\", \"Midwest\", \"Southwest\", \"West\"]\n","for i in range(NUM_REGIONS):\n","    regions_data.append({\n","        \"RegionID\": i + 1,\n","        \"RegionName\": region_names[i]\n","    })\n","regions_df = pd.DataFrame(regions_data)\n","regions_df.to_csv(os.path.join(OUTPUT_DIR, \"regions.csv\"), index=False, quoting=csv.QUOTE_NONNUMERIC)\n","print(f\"Generated {len(regions_df)} regions.\")\n","\n","# 2. Agents\n","print(\"Generating Agents...\")\n","agents_data = []\n","for i in range(NUM_AGENTS):\n","    hire_date = random_date(START_DATE - timedelta(days=365*5), START_DATE - timedelta(days=30))\n","    agents_data.append({\n","        \"AgentID\": i + 101, # Start Agent IDs from 101\n","        \"AgentName\": fake.name(),\n","        \"RegionID\": random.choice(regions_df[\"RegionID\"]),\n","        \"HireDate\": hire_date.strftime('%Y-%m-%d')\n","    })\n","agents_df = pd.DataFrame(agents_data)\n","agents_df.to_csv(os.path.join(OUTPUT_DIR, \"agents.csv\"), index=False, quoting=csv.QUOTE_NONNUMERIC)\n","print(f\"Generated {len(agents_df)} agents.\")\n","\n","# 3. Customers\n","print(\"Generating Customers...\")\n","customers_data = []\n","for i in range(NUM_CUSTOMERS):\n","    join_d = random_date(START_DATE - timedelta(days=365*3), END_DATE - timedelta(days=60))\n","    birth_d = fake.date_of_birth(minimum_age=18, maximum_age=80)\n","    customers_data.append({\n","        \"CustomerID\": i + 1001, # Start Customer IDs from 1001\n","        \"CustomerName\": fake.name(),\n","        \"BirthDate\": birth_d.strftime('%Y-%m-%d'),\n","        \"Address\": fake.street_address(),\n","        \"City\": fake.city(),\n","        \"State\": fake.state_abbr(),\n","        \"ZipCode\": fake.zipcode(),\n","        \"JoinDate\": join_d.strftime('%Y-%m-%d')\n","    })\n","customers_df = pd.DataFrame(customers_data)\n","customers_df.to_csv(os.path.join(OUTPUT_DIR, \"customers.csv\"), index=False, quoting=csv.QUOTE_NONNUMERIC)\n","print(f\"Generated {len(customers_df)} customers.\")\n","\n","# 4. Vehicles\n","print(\"Generating Vehicles...\")\n","vehicles_data = []\n","vehicle_makes_models = {\n","    \"Toyota\": [\"Camry\", \"Corolla\", \"RAV4\", \"Highlander\"],\n","    \"Ford\": [\"F-150\", \"Escape\", \"Explorer\", \"Mustang\"],\n","    \"Honda\": [\"Civic\", \"Accord\", \"CR-V\", \"Pilot\"],\n","    \"Chevrolet\": [\"Silverado\", \"Equinox\", \"Malibu\", \"Tahoe\"],\n","    \"BMW\": [\"3 Series\", \"5 Series\", \"X3\", \"X5\"],\n","    \"Nissan\": [\"Altima\", \"Sentra\", \"Rogue\"],\n","    \"Mercedes-Benz\": [\"C-Class\", \"E-Class\", \"GLC\"]\n","}\n","makes = list(vehicle_makes_models.keys())\n","for i in range(NUM_VEHICLES):\n","    make = random.choice(makes)\n","    model = random.choice(vehicle_makes_models[make])\n","    year = random.randint(2010, 2024)\n","    vehicles_data.append({\n","        \"VehicleID\": i + 5001, # Start Vehicle IDs from 5001\n","        \"Make\": make,\n","        \"Model\": model,\n","        \"Year\": year,\n","        \"VIN\": generate_vin()\n","    })\n","vehicles_df = pd.DataFrame(vehicles_data)\n","vehicles_df.to_csv(os.path.join(OUTPUT_DIR, \"vehicles.csv\"), index=False, quoting=csv.QUOTE_NONNUMERIC)\n","print(f\"Generated {len(vehicles_df)} vehicles.\")\n","\n","# 5. Policies\n","print(\"Generating Policies...\")\n","policies_data = []\n","policy_types = [\"Comprehensive\", \"Liability Only\", \"Collision\"]\n","coverage_details = [\"100/300/50\", \"50/100/25\", \"250/500/100\", \"State Minimum\"]\n","policy_id_counter = 20001 # Start Policy IDs from 20001\n","\n","# Ensure each customer has at least one policy\n","customer_ids_with_policies = set()\n","\n","for i in range(NUM_POLICIES):\n","    cust_id = random.choice(customers_df[\"CustomerID\"])\n","    customer_ids_with_policies.add(cust_id)\n","    veh_id = random.choice(vehicles_df[\"VehicleID\"]) # Allow vehicles to be reused (e.g., sold/bought)\n","    agent_id = random.choice(agents_df[\"AgentID\"])\n","    start_d = random_date(START_DATE, END_DATE - timedelta(days=365)) # Policy starts before end date\n","    end_d = start_d + timedelta(days=random.randint(180, 366)) # Policy duration ~6m to 1y\n","    if end_d > END_DATE:\n","        end_d = END_DATE\n","\n","    policies_data.append({\n","        \"PolicyID\": policy_id_counter,\n","        \"CustomerID\": cust_id,\n","        \"VehicleID\": veh_id,\n","        \"AgentID\": agent_id,\n","        \"PolicyType\": random.choice(policy_types),\n","        \"StartDate\": start_d.strftime('%Y-%m-%d'),\n","        \"EndDate\": end_d.strftime('%Y-%m-%d'),\n","        \"AnnualPremium\": round(random.uniform(500.0, 4000.0), 2),\n","        \"CoverageDetails\": random.choice(coverage_details)\n","    })\n","    policy_id_counter += 1\n","\n","# Ensure all customers have at least one policy\n","remaining_customers = set(customers_df[\"CustomerID\"]) - customer_ids_with_policies\n","for cust_id in remaining_customers:\n","    veh_id = random.choice(vehicles_df[\"VehicleID\"])\n","    agent_id = random.choice(agents_df[\"AgentID\"])\n","    start_d = random_date(START_DATE, END_DATE - timedelta(days=365))\n","    end_d = start_d + timedelta(days=random.randint(180, 366))\n","    if end_d > END_DATE:\n","        end_d = END_DATE\n","    policies_data.append({\n","        \"PolicyID\": policy_id_counter,\n","        \"CustomerID\": cust_id,\n","        \"VehicleID\": veh_id,\n","        \"AgentID\": agent_id,\n","        \"PolicyType\": random.choice(policy_types),\n","        \"StartDate\": start_d.strftime('%Y-%m-%d'),\n","        \"EndDate\": end_d.strftime('%Y-%m-%d'),\n","        \"AnnualPremium\": round(random.uniform(500.0, 4000.0), 2),\n","        \"CoverageDetails\": random.choice(coverage_details)\n","    })\n","    policy_id_counter += 1\n","\n","\n","policies_df = pd.DataFrame(policies_data)\n","policies_df.to_csv(os.path.join(OUTPUT_DIR, \"policies.csv\"), index=False, quoting=csv.QUOTE_NONNUMERIC)\n","print(f\"Generated {len(policies_df)} policies.\")\n","\n","# 6. Claims\n","print(\"Generating Claims...\")\n","claims_data = []\n","claim_id_counter = 50001 # Start Claim IDs from 50001\n","claim_types = [\"Collision\", \"Theft\", \"Vandalism\", \"Bodily Injury\", \"Property Damage\", \"Comprehensive\", \"Uninsured Motorist\"]\n","claim_statuses = [\"Open\", \"Processing\", \"Approved\", \"Denied\", \"Paid\", \"Closed\"]\n","\n","for _, policy in policies_df.iterrows():\n","    num_claims = random.randint(NUM_CLAIMS_PER_POLICY_RANGE[0], NUM_CLAIMS_PER_POLICY_RANGE[1])\n","    policy_start = datetime.strptime(policy[\"StartDate\"], '%Y-%m-%d')\n","    policy_end = datetime.strptime(policy[\"EndDate\"], '%Y-%m-%d')\n","\n","    for _ in range(num_claims):\n","        # Incident must happen during policy period\n","        incident_d = random_date(policy_start, policy_end)\n","        # Claim reported shortly after incident\n","        claim_d = incident_d + timedelta(days=random.randint(1, 30))\n","        if claim_d > END_DATE: # Ensure claim date is within overall timeframe\n","             claim_d = END_DATE if incident_d < END_DATE else incident_d # Adjust if incident near end date\n","\n","        claim_status = random.choice(claim_statuses)\n","        claim_amount = round(random.uniform(100.0, 50000.0), 2)\n","        # Higher amounts more likely for certain types\n","        claim_type = random.choice(claim_types)\n","        if claim_type in [\"Bodily Injury\", \"Theft\", \"Collision\"]:\n","             claim_amount = round(random.uniform(1000.0, 75000.0), 2)\n","\n","        # Simple fraud indicator logic (e.g., higher chance for large amounts or specific types)\n","        fraud_indicator = 1 if (random.random() < 0.05 or (claim_amount > 40000 and random.random() < 0.2)) else 0\n","\n","        claims_data.append({\n","            \"ClaimID\": claim_id_counter,\n","            \"PolicyID\": policy[\"PolicyID\"],\n","            \"ClaimDate\": claim_d.strftime('%Y-%m-%d'),\n","            \"IncidentDate\": incident_d.strftime('%Y-%m-%d'),\n","            \"ClaimType\": claim_type,\n","            \"ClaimAmount\": claim_amount,\n","            \"ClaimStatus\": claim_status,\n","            \"IncidentDescription\": fake.sentence(nb_words=10),\n","            \"FraudIndicator\": fraud_indicator\n","        })\n","        claim_id_counter += 1\n","\n","claims_df = pd.DataFrame(claims_data)\n","claims_df.to_csv(os.path.join(OUTPUT_DIR, \"claims.csv\"), index=False, quoting=csv.QUOTE_NONNUMERIC)\n","print(f\"Generated {len(claims_df)} claims.\")\n","\n","\n","# 7. Claim Payments\n","print(\"Generating Claim Payments...\")\n","payments_data = []\n","payment_id_counter = 80001 # Start Payment IDs from 80001\n","payment_types = [\"Vehicle Repair\", \"Medical\", \"Rental Car\", \"Settlement\", \"Property Damage Payment\"]\n","\n","# Filter for claims that would likely have payments\n","payable_claims = claims_df[claims_df['ClaimStatus'].isin(['Approved', 'Paid', 'Closed'])]\n","\n","for _, claim in payable_claims.iterrows():\n","    num_payments = random.randint(NUM_PAYMENTS_PER_CLAIM_RANGE[0], NUM_PAYMENTS_PER_CLAIM_RANGE[1])\n","    total_paid = 0\n","    claim_date = datetime.strptime(claim[\"ClaimDate\"], '%Y-%m-%d')\n","    claim_amount = claim[\"ClaimAmount\"]\n","\n","    for i in range(num_payments):\n","        # Payment occurs after claim date\n","        payment_d = claim_date + timedelta(days=random.randint(5, 180))\n","        if payment_d > END_DATE:\n","             payment_d = END_DATE # Cap payment date\n","\n","        # Ensure payment amount is reasonable relative to claim amount and previous payments\n","        remaining_claim_amount = max(0, claim_amount - total_paid)\n","        max_payment = remaining_claim_amount if i < num_payments - 1 else remaining_claim_amount # Last payment covers remainder up to claim amount\n","        payment_amount = round(random.uniform(50.0, max(100, max_payment * random.uniform(0.3, 1.0))), 2) # Pay portion\n","        payment_amount = min(payment_amount, remaining_claim_amount) # Don't exceed remaining claim amount\n","\n","        if payment_amount <= 0 and remaining_claim_amount > 0: # Ensure some payment if amount remains\n","             payment_amount = round(remaining_claim_amount * random.uniform(0.1, 0.5), 2)\n","        elif remaining_claim_amount <=0:\n","             continue # Skip if claim already fully paid\n","\n","        total_paid += payment_amount\n","\n","        payments_data.append({\n","            \"PaymentID\": payment_id_counter,\n","            \"ClaimID\": claim[\"ClaimID\"],\n","            \"PaymentDate\": payment_d.strftime('%Y-%m-%d'),\n","            \"PaymentAmount\": payment_amount,\n","            \"PaymentType\": random.choice(payment_types)\n","        })\n","        payment_id_counter += 1\n","\n","payments_df = pd.DataFrame(payments_data)\n","payments_df.to_csv(os.path.join(OUTPUT_DIR, \"claim_payments.csv\"), index=False, quoting=csv.QUOTE_NONNUMERIC)\n","print(f\"Generated {len(payments_df)} claim payments.\")\n","\n","# 8. Monthly Claim Summaries (Aggregate)\n","print(\"Generating Monthly Claim Summaries...\")\n","# Ensure ClaimDate is datetime\n","claims_df['ClaimDate'] = pd.to_datetime(claims_df['ClaimDate'])\n","claims_df['YearMonth'] = claims_df['ClaimDate'].dt.strftime('%Y-%m')\n","\n","monthly_summaries = claims_df.groupby(['PolicyID', 'YearMonth']).agg(\n","    TotalClaimsCount=('ClaimID', 'nunique'), # Use nunique for distinct claims\n","    TotalClaimsAmount=('ClaimAmount', 'sum')\n",").reset_index()\n","\n","monthly_summaries['SummaryID'] = range(1, len(monthly_summaries) + 1)\n","# Reorder columns\n","monthly_summaries = monthly_summaries[['SummaryID', 'PolicyID', 'YearMonth', 'TotalClaimsCount', 'TotalClaimsAmount']]\n","\n","monthly_summaries.to_csv(os.path.join(OUTPUT_DIR, \"monthly_claim_summaries.csv\"), index=False, quoting=csv.QUOTE_NONNUMERIC)\n","print(f\"Generated {len(monthly_summaries)} monthly summary records.\")\n","\n","\n","# 9. Regional Sales Performance (Aggregate)\n","print(\"Generating Regional Sales Performance...\")\n","# Ensure StartDate is datetime and join with Agents to get RegionID\n","policies_df['StartDate'] = pd.to_datetime(policies_df['StartDate'])\n","#policies_df['YearQuarter'] = policies_df['StartDate'].dt.to_period('Q').strftime('%Y-Q%q')\n","policies_df['YearQuarter'] = policies_df['StartDate'].dt.to_period('Q').dt.strftime('%Y-Q%q')\n","\n","# Merge policies with agents to get RegionID\n","policies_with_agents = pd.merge(policies_df, agents_df[['AgentID', 'RegionID']], on='AgentID', how='left')\n","\n","regional_performance = policies_with_agents.groupby(['AgentID', 'RegionID', 'YearQuarter']).agg(\n","    TotalPremiumsWritten=('AnnualPremium', 'sum')\n",").reset_index()\n","\n","regional_performance['PerfID'] = range(1, len(regional_performance) + 1)\n","# Reorder columns\n","regional_performance = regional_performance[['PerfID', 'AgentID', 'RegionID', 'YearQuarter', 'TotalPremiumsWritten']]\n","\n","regional_performance.to_csv(os.path.join(OUTPUT_DIR, \"regional_sales_performance.csv\"), index=False, quoting=csv.QUOTE_NONNUMERIC)\n","print(f\"Generated {len(regional_performance)} regional performance records.\")\n","\n","\n","print(\"\\n--- Data Generation Complete ---\")\n","print(f\"CSV files saved in directory: {OUTPUT_DIR}\")\n","\n","# Optional: Display first few rows of each dataframe\n","# print(\"\\nRegions Sample:\\n\", regions_df.head())\n","# print(\"\\nAgents Sample:\\n\", agents_df.head())\n","# print(\"\\nCustomers Sample:\\n\", customers_df.head())\n","# print(\"\\nVehicles Sample:\\n\", vehicles_df.head())\n","# print(\"\\nPolicies Sample:\\n\", policies_df.head())\n","# print(\"\\nClaims Sample:\\n\", claims_df.head())\n","# print(\"\\nClaim Payments Sample:\\n\", payments_df.head())\n","# print(\"\\nMonthly Summaries Sample:\\n\", monthly_summaries.head())\n","# print(\"\\nRegional Performance Sample:\\n\", regional_performance.head())"],"outputs":[{"output_type":"stream","name":"stdout","text":["Generating Regions...\n","Generated 5 regions.\n","Generating Agents...\n","Generated 50 agents.\n","Generating Customers...\n","Generated 2000 customers.\n","Generating Vehicles...\n","Generated 2200 vehicles.\n","Generating Policies...\n","Generated 3086 policies.\n","Generating Claims...\n","Generated 6164 claims.\n","Generating Claim Payments...\n","Generated 6167 claim payments.\n","Generating Monthly Claim Summaries...\n","Generated 5495 monthl